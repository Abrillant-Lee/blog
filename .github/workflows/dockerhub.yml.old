name: 构建镜像并推送到Docker Hub

on: push # 当有内容push到仓库时触发

# 权限配置
permissions:
  contents: write
  pull-requests: write

jobs:
  pnpm-build:
    name: 构建镜像并推送到Docker Hub
    runs-on: ubuntu-latest

    steps:
    - name: 读取仓库内容😁
      uses: actions/checkout@v4

    - name: 登录DockerHub🧗‍♂️
      uses: docker/login-action@v3.1.0
      with:
        username: ${{ secrets.DOCKER_HUB_USERNAME}}
        password: ${{ secrets.DOCKER_HUB_TOCKEN}}

    - name: 构建并推送到Docker Hub🫱
      uses: docker/build-push-action@v5
      with:
        push: true
        tags: abrillantlee/docusaurus-app:latest


